# Copy this file to .env and adjust as needed.

# ── LLM provider ──────────────────────────────────────────────────────────
# One of: gemini | openai | anthropic | ollama | none
LLM_PROVIDER=gemini

# Only the API key matching LLM_PROVIDER needs to be set.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Override model names per provider (sensible defaults are baked in).
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OLLAMA_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434

# ── Database ──────────────────────────────────────────────────────────────
# Defaults to a local SQLite file under backend/data/. Uncomment to use
# Postgres instead:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/open_resume_studio

# ── Storage ───────────────────────────────────────────────────────────────
# Where uploaded resumes and generated PDFs live.
# STORAGE_DIR=./data/storage

# ── URLs / CORS ───────────────────────────────────────────────────────────
# FRONTEND_URL=http://localhost:3000
# API_URL=http://localhost:8000
# ALLOWED_ORIGINS=http://localhost:3000
